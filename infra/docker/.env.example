# Copy to .env and edit. Never commit the real .env (see .gitignore).

# ---- image ------------------------------------------------------------------
MGMT_IMAGE=mgmt-web:latest

# ---- app --------------------------------------------------------------------
# Web login password. Seeded into web-auth.yaml on first boot (mgmt web setpass).
MGMT_WEB_PASSWORD=change-me-please
# Public HTTPS origin: enables Secure cookies + the CSRF Origin check.
MGMT_PUBLIC_ORIGIN=https://mgmt.example.com
# Bind inside the container. Keep 0.0.0.0 so Traefik / the host proxy can reach it.
MGMT_BIND=0.0.0.0:8321

# ---- reverse proxy ----------------------------------------------------------
# Empty   -> no proxy; app is published on 127.0.0.1:8321 for your own Caddy/nginx.
# traefik -> run bundled Traefik with automatic Let's Encrypt over DNS-01.
COMPOSE_PROFILES=

# ---- Traefik / ACME (only read when COMPOSE_PROFILES=traefik) ----------------
MGMT_DOMAIN=mgmt.example.com
ACME_EMAIL=you@example.com
# Staging avoids the strict prod rate limits while you get it working; flip to
# https://acme-v02.api.letsencrypt.org/directory once a staging cert is issued.
ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# DNS-01 provider (lego provider code): cloudflare, route53, digitalocean, gandiv5, ...
# Full list: https://go-acme.github.io/lego/dns/
TRAEFIK_DNS_PROVIDER=cloudflare

# --- provider credentials: fill ONLY the block for your provider ---
# Cloudflare — scoped API token with Zone:Read + DNS:Edit on the zone:
CF_DNS_API_TOKEN=
# Cloudflare (legacy global key) — CF_API_EMAIL + CF_API_KEY instead of the token:
CF_API_EMAIL=
CF_API_KEY=
# AWS Route 53:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_HOSTED_ZONE_ID=
# DigitalOcean:
DO_AUTH_TOKEN=
# Gandi v5:
GANDIV5_PERSONAL_ACCESS_TOKEN=
