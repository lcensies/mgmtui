{{ ansible_managed | comment }}
MGMT_IMAGE={{ mgmt_web_image }}
MGMT_WEB_PASSWORD={{ mgmt_web_password }}
MGMT_PUBLIC_ORIGIN={{ mgmt_web_public_origin }}
MGMT_BIND={{ mgmt_web_bind }}
{% if mgmt_web_reverse_proxy == 'traefik' %}
MGMT_DOMAIN={{ mgmt_web_domain }}
ACME_EMAIL={{ mgmt_web_acme_email }}
ACME_CA_SERVER={{ mgmt_web_acme_ca_server }}
TRAEFIK_DNS_PROVIDER={{ mgmt_web_dns_provider }}
{% for key, value in mgmt_web_dns_env.items() %}
{{ key }}={{ value }}
{% endfor %}
{% endif %}
